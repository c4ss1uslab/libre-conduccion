rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if true;
    }
    match /sessions/{sessionId} {
      allow read, write: if true;
    }
    match /gestures/{gestureId} {
      allow read, write: if true;
    }
    match /tracks/{trackId} {
      allow read, write: if true;
    }
  }
}
